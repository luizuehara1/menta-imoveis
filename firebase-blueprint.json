        "codigoImovel": { "type": "string" },
        "locacaoId": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmado", "pendente"] },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" }
      }
    },
    "Option": {
      "title": "Property Option List",
      "description": "Document containing an array of options for property fields",
      "type": "object",
      "properties": {
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "nome": { "type": "string" },
              "valor": { "type": "string" },
              "ativo": { "type": "boolean" },
              "ordem": { "type": "number" },
              "cidade": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SiteConfig": {
      "title": "Site Configuration",
      "description": "General settings for the website's content and appearance",
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "tituloPrincipal": { "type": "string" },
            "subtitulo": { "type": "string" },
            "textoBotaoPrincipal": { "type": "string" },
            "linkBotaoPrincipal": { "type": "string" },
            "textoBotaoSecundario": { "type": "string" },
            "linkBotaoSecundario": { "type": "string" },
            "imagemFundoUrl": { "type": "string" },
            "ativarThreeJs": { "type": "boolean" }
          }
        },
        "secoes": {
          "type": "object",
          "properties": {
            "imoveisDestaque": {
              "type": "object",
              "properties": {
                "titulo": { "type": "string" },
                "subtitulo": { "type": "string" }
              }
