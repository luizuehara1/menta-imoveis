            "sobre": {
              "type": "object",
              "properties": {
                "titulo": { "type": "string" },
                "texto": { "type": "string" },
                "imagemUrl": { "type": "string" }
              }
            },
            "corretores": {
              "type": "object",
              "properties": {
                "titulo": { "type": "string" },
                "subtitulo": { "type": "string" }
              }
            },
            "contato": {
              "type": "object",
              "properties": {
                "titulo": { "type": "string" },
                "texto": { "type": "string" }
              }
            }
          }
        },
        "empresa": {
          "type": "object",
          "properties": {
            "nome": { "type": "string" },
            "slogan": { "type": "string" },
            "creci": { "type": "string" },
            "whatsapp": { "type": "string" },
            "instagram": { "type": "string" },
            "email": { "type": "string" },
            "endereco": { "type": "string" },
            "cidadeEstado": { "type": "string" },
            "googleMapsUrl": { "type": "string" }
          }
        },
        "aparencia": {
          "type": "object",
          "properties": {
            "corPrincipal": { "type": "string" },
            "corSecundaria": { "type": "string" },
            "corFundo": { "type": "string" },
            "corTexto": { "type": "string" },
            "logoUrl": { "type": "string" },
            "faviconUrl": { "type": "string" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Contract": {
      "title": "Contract",
      "description": "Purchase proposals, counter-proposals and acceptances",
      "type": "object",
      "properties": {
        "tipoContrato": { "type": "string", "enum": ["proposta", "contraproposta", "aceite"] },
        "status": { "type": "string", "enum": ["rascunho", "enviado", "assinado", "cancelado"] },
        "nomeCliente": { "type": "string" },
        "nomeVendedor": { "type": "string" },
        "enderecoImovel": { "type": "string" },
        "valor": { "type": "number" },
        "dados": { "type": "object" },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" },
        "criadoPor": { "type": "string" },
        "imovelId": { "type": "string" },
        "observacoes": { "type": "string" }
      }
    },
    "LeaseConfig": {
      "title": "Lease Configuration Item",
      "description": "Item used in lease dropdowns/options",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "ativo": { "type": "boolean" },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" }
      }
    },
    "Neighborhood": {
      "title": "Neighborhood",
      "description": "Neighborhood record",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "cidade": { "type": "string" },
        "estado": { "type": "string" },
        "ativo": { "type": "boolean" },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" }
      }
    },
    "Lease": {
      "title": "Lease Agreement",
      "description": "Active rental contract",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "propertyCode": { "type": "string" },
        "propertyTitle": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "propertyNeighborhood": { "type": "string" },
        "propertyCity": { "type": "string" },
        "tenantName": { "type": "string" },
        "tenantPhone": { "type": "string" },
        "tenantCpf": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "dueDay": { "type": "number" },
        "valorAluguel": { "type": "number" },
        "valorIptu": { "type": "number" },
        "valorTaxaLixo": { "type": "number" },
        "valorCondominio": { "type": "number" },
        "valorOutros": { "type": "number" },
        "valorDesconto": { "type": "number" },
        "valorTotalPagar": { "type": "number" },
        "statusPagamento": { "type": "string", "enum": ["Pendente", "Pago", "Atrasado", "Cancelado"] },
        "statusLocacao": { "type": "string", "enum": ["Ativa", "Encerrada", "Cancelada"] },
        "lastPaymentDate": { "type": "string", "format": "date" },
        "lastPaymentMonth": { "type": "string" },
        "observacoes": { "type": "string" },
        "active": { "type": "boolean" },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" }
      }
    },
    "ContractClause": {
      "title": "Contract Clause",
      "description": "Customizable clauses for lease, purchase and proposal contracts",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "texto": { "type": "string" },
        "tipoContrato": { "type": "string", "enum": ["locacao", "locacao_temporaria", "compra_venda", "proposta", "contraproposta", "aceite", "recibo", "todos"] },
        "ordem": { "type": "number" },
        "ativo": { "type": "boolean" },
        "obrigatoria": { "type": "boolean" },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["titulo", "texto", "tipoContrato", "ordem", "ativo"]
    }
  },
  "firestore": {
    "siteSettings": {
      "schema": "SiteConfig",
      "description": "Public site content and design settings"
    },
    "administradores": {
      "schema": "Admin",
      "description": "List of authorized administrator emails"
    },
    "imoveis": {
      "schema": "Property",
