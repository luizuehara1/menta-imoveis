        "installations": { "type": "array", "items": { "type": "string" } },
        "finishes": { "type": "array", "items": { "type": "string" } },
        "leisure": { "type": "array", "items": { "type": "string" } },
        "locationTags": { "type": "array", "items": { "type": "string" } },
        "proximities": { "type": "array", "items": { "type": "string" } },
        "destaque": { "type": "boolean" },
        "publicado": { "type": "boolean" },
        "rented": { "type": "boolean" },
        "iptu": { "type": "number" },
        "condoFee": { "type": "number" },
        "taxes": { "type": "number" },
        "buildingName": { "type": "string" },
        "condoName": { "type": "string" },
        "isBuilding": { "type": "boolean" },
        "isCondo": { "type": "boolean" },
        "fireInsurance": { "type": "number" },
        "totalMonthlyPrice": { "type": "number" },
        "leaseWarrantyType": { "type": "string" },
        "allowsPet": { "type": "string", "enum": ["Sim", "Não"] },
        "furnishingStatus": { "type": "string", "enum": ["Mobiliado", "Parcialmente", "Não Mobiliado"] },
        "minLeaseTerm": { "type": "string" },
        "availableForVisit": { "type": "string", "enum": ["Sim", "Não"] },
        "leaseStatus": { "type": "string" },
        "leaseNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      }
    },
    "Visit": {
      "title": "Visit Request",
      "description": "Requested and confirmed property visits",
      "type": "object",
      "properties": {
        "nomeCliente": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "imovelId": { "type": "string" },
        "codigoImovel": { "type": "string" },
        "tituloImovel": { "type": "string" },
        "cidade": { "type": "string" },
        "bairro": { "type": "string" },
        "data": { "type": "string" },
        "horario": { "type": "string" },
        "mensagem": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "confirmada", "realizada", "cancelada"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Broker": {
      "title": "Broker",
      "description": "Real estate brokers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "creci": { "type": "string" },
        "instagram": { "type": "string" },
        "active": { "type": "boolean" }
      }
    },
    "Expense": {
      "title": "Expense",
      "description": "Financial expense record",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "value": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "responsible": { "type": "string" },
        "notes": { "type": "string" },
        "receiptUrl": { "type": "string" }
      }
    },
    "Revenue": {
      "title": "Revenue",
      "description": "Financial revenue record",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "brokerId": { "type": "string" },
        "propertyId": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "FinanceRecord": {
      "title": "Finance Record",
      "description": "Unified financial transaction record (inflow/outflow)",
      "type": "object",
      "properties": {
        "tipo": { "type": "string", "enum": ["entrada", "saida"] },
        "data": { "type": "string" },
        "valor": { "type": "number" },
        "descricao": { "type": "string" },
        "categoria": { "type": "string" },
        "clienteOrigem": { "type": "string" },
        "responsavel": { "type": "string" },
        "formaPagamento": { "type": "string" },
        "formaRecebimento": { "type": "string" },
        "observacoes": { "type": "string" },
