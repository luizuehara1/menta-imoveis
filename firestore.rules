rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailAdmin(email) {
      return email == 'luiz.uehara1@gmail.com' ||
             email == 'edson.menta@hotmail.com' ||
             email == 'anamariamenta@hotmail.com' ||
             (exists(/databases/$(database)/documents/administradores/$(email)) &&
              get(/databases/$(database)/documents/administradores/$(email)).data.get('ativo', false) == true) ||
             (exists(/databases/$(database)/documents/admins/$(email)) &&
              get(/databases/$(database)/documents/admins/$(email)).data.get('ativo', false) == true);
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             isEmailAdmin(request.auth.token.email.lower());
    }

    // Public Collections - Anyone can read, only Admin can write
    match /siteSettings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /configuracoes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /configuracao/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    // Core Options Collection
    match /opcoes_imoveis/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /opcoes_imoveis/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    // Support for top-level collections as requested
    match /lazer/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /instalacoes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /tiposNegocio/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /localizacoes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /faixasPreco/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /caracteristicas/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /statusImovel/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /acabamentos/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /cidades/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /tiposImovel/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /bairros/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    match /opcoes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /corretores/{document=**} { allow read: if true; allow write: if isAdmin(); }

    match /imoveis/{id} {
      allow read: if isAdmin()
        || resource.data.publicadoNoSite == true
        || resource.data.publicado == true;

      allow create, update, delete: if isAdmin();
      
      match /privado/{details=**} {
        allow read, write: if isAdmin();
      }
    }

    match /properties/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /visitas/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /agendamentos/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /solicitacoesVisita/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Protected Collections
    match /clausulasContratos/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /locacoes/{document=**} { allow read, write: if isAdmin(); }
    match /contratos/{document=**} { allow read, write: if isAdmin(); }
    match /contratosGerados/{document=**} { allow read, write: if isAdmin(); }
    match /financeiro/{document=**} { allow read, write: if isAdmin(); }
    match /gastos/{document=**} { allow read, write: if isAdmin(); }
    match /receitas/{document=**} { allow read, write: if isAdmin(); }
    match /fichas_visita/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /recibos/{document=**} { allow read, write: if isAdmin(); }
    match /recibosEditaveis/{document=**} { allow read, write: if isAdmin(); }
    match /pagamentosLocacao/{document=**} { allow read, write: if isAdmin(); }
    match /propostas/{document=**} { allow read, write: if isAdmin(); }

    match /administradores/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isAdmin());
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isAdmin());
      allow write: if isAdmin();
    }

    match /configLocacaoGarantias/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /configLocacaoStatus/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /configLocacaoContratos/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /configLocacaoRegras/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
