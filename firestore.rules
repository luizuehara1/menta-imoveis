rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             (
               request.auth.token.email.lower() == 'luiz.uehara1@gmail.com' ||
               (exists(/databases/$(database)/documents/administradores/$(request.auth.token.email.lower())) &&
                get(/databases/$(database)/documents/administradores/$(request.auth.token.email.lower())).data.get('ativo', false) == true)
             );
    }

    // Public Collections
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracoes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /opcoes_imoveis/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /corretores/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /imoveis/{id} {
      allow read: if (resource.data.get('publicado', false) == true) || isAdmin();
      allow write: if isAdmin();
      
      match /privado/{details=**} {
        allow read, write: if isAdmin();
      }
    }

    match /visitas/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Protected Collections
    match /locacoes/{id} {
      allow read, write: if isAdmin();
    }

    match /administradores/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || request.auth.token.email.lower() == 'luiz.uehara1@gmail.com');
      allow create: if isSignedIn() && email.lower() == 'luiz.uehara1@gmail.com';
      allow update, delete: if isSignedIn() && request.auth.token.email.lower() == 'luiz.uehara1@gmail.com';
    }

    match /gastos/{id} { allow read, write: if isAdmin(); }
    match /receitas/{id} { allow read, write: if isAdmin(); }
    match /fichas_visita/{id} { allow read, write: if isAdmin(); }
    match /contratos/{id} { allow read, write: if isAdmin(); }
    
    match /configLocacaoGarantias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configLocacaoStatus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configLocacaoContratos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configLocacaoRegras/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bairros/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /locacoes/{id} {
      allow read, write: if isAdmin();
    }
  }
}
