rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'T6XcUvoTBDh353qYJJEGTmghSsF3' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'luiz.uehara1@gmail.com' ||
          request.auth.token.email.lower() == 'edson.menta@hotmail.com' ||
          request.auth.token.email.lower() == 'anamariamenta@hotmail.com' ||
          request.auth.token.email == 'luiz.uehara1@gmail.com' ||
          request.auth.token.email == 'edson.menta@hotmail.com' ||
          request.auth.token.email == 'anamariamenta@hotmail.com' ||
          request.auth.token.email == 'LUIZ.UEHARA1@GMAIL.COM' ||
          request.auth.token.email == 'EDSON.MENTA@HOTMAIL.COM' ||
          request.auth.token.email == 'ANAMARIAMENTA@HOTMAIL.COM'
        ))
      );
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isSignedIn() && request.auth.token.email != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/administradores/$(request.auth.token.email))
        )
      );
    }

    function isAdminAtivo() {
      return isMasterAdmin() || (
        isSignedIn() && (
          (request.auth.token.email != null && (
            (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.ativo != false) ||
            (exists(/databases/$(database)/documents/administradores/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.ativo != false)
          )) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo != false)
        )
      );
    }

    // 1. Pagamentos e Cobranças
    match /pagamentosLocacao/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /pagamentos/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /pagamentosPendentes/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /recebimentos/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    // 2. Financeiro e Transações
    match /financeiro/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /transacoesFinanceiras/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /financialTransactions/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /contasFinanceiras/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /transferenciasFinanceiras/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    // 3. Locações e Contratos
    match /locacoes/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    // Locação Temporária
    match /reservasTemporada/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /bloqueiosTemporada/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminAtivo();
    }

    match /ocupacaoTemporada/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminAtivo();
    }

    match /precosTemporada/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminAtivo();
    }

    match /solicitacoesReservaTemporada/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdminAtivo();
    }

    match /hospedesTemporada/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /pagamentosTemporada/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /recibosTemporada/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /contratos/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    match /templatesContrato/{docId} {
      allow read, create, update, delete: if isAdminAtivo();
    }

    // 4. Imóveis
    match /imoveis/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminAtivo();
    }

    // 5. Configurações e Logs
    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if isAdminAtivo();
    }

    match /administradores/{email} {
      allow read: if isSignedIn();
      allow write: if isAdminAtivo();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdminAtivo();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdminAtivo();
    }

    match /bairros/{docId} {
      allow read: if true;
      allow write: if isAdminAtivo();
    }

    match /corretores/{docId} {
      allow read: if true;
      allow write: if isAdminAtivo();
    }

    match /opcoes_imoveis/{docId} {
      allow read: if true;
      allow write: if isAdminAtivo();
    }

    match /configuracoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminAtivo();
    }

    match /visitas/{docId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isAdminAtivo();
    }

    // Fallback restritivo para administradores ativos
    match /{document=**} {
      allow read, write: if isAdminAtivo();
    }
  }
}
